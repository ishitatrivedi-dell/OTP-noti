# Backend
PORT=5001

# MongoDB: the server tries MONGO_URI first, then LOCAL_MONGO_URI.
# Set MONGO_URI to a remote MongoDB URI if you have one; otherwise leave it unset.
# For an authenticated local MongoDB, use its username/password and authSource:
# LOCAL_MONGO_URI=mongodb://username:password@127.0.0.1:27017/transparent-backend-visualizer?authSource=admin

# Email: "test" uses Ethereal previews and never delivers to real inboxes.
EMAIL_MODE=test

# For real Gmail delivery, set EMAIL_MODE=gmail and provide a Gmail App Password.
# EMAIL_MODE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-character-app-password
